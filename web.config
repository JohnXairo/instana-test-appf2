<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    =======================================================
     AMBIENTE DE PRUEBA — Emula Windows Server 2012 R2
     IIS 8.5 · .NET Framework 3.5 · CLR v2.0
    =======================================================

    App Pool debe configurarse con:
      .NET CLR Version        = v2.0
      Managed Pipeline Mode   = Integrated

    Con esa config w3wp.exe arranca con:
      -v "v2.0" -l "webengine4.dll"
  -->

  <system.web>
    <compilation debug="true" targetFramework="3.5" />
    <httpRuntime targetFramework="3.5" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
    </handlers>
  </system.webServer>

  <appSettings>
    <!-- URL destino para las llamadas HTTP salientes de prueba -->
    <add key="TargetUrl" value="http://httpbin.org/get" />
    <!-- Nombre de la app que aparecera en Instana -->
    <add key="AppName"   value="InstanaTestApp-CLR2" />
  </appSettings>

</configuration>